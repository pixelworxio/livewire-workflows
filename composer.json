{
    "name": "pixelworxio/livewire-workflows",
    "description": "Pipeline-driven workflow router for Laravel Livewire with auto-registered routes and readable DSL",
    "keywords": ["laravel", "livewire", "workflow", "multistep", "forms"],
    "type": "library",
    "homepage": "https://github.com/pixelworxio/livewire-workflows",
    "license": "MIT",
    "authors": [
        {
            "name": "Whoisthisstud",
            "email": "44807533+whoisthisstud@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^11.0||^12.0",
        "illuminate/pipeline": "^11.0|^12.0",
        "illuminate/support": "^11.0|^12.0",
        "livewire/livewire": "^3.0|^4.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.8",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10.0.0||^9.0.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Pixelworxio\\LivewireWorkflows\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Pixelworxio\\LivewireWorkflows\\Tests\\": "tests/",
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "scripts": {
        "test": "vendor/bin/pest"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pixelworxio\\LivewireWorkflows\\LivewireWorkflowsServiceProvider"
            ],
            "aliases": {
                "Workflow": "Pixelworxio\\LivewireWorkflows\\Facades\\Workflow"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
